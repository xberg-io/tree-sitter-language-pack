#!/usr/bin/env stap

global counts
global limit = 100

@define report_header %( printf("%-20s %s\n", "process", "calls") %)

function format_count:string(name:string, count:long)
{
	return sprintf("%-20s %d", name, count)
}

probe syscall_entry = syscall.*
{
	process_name = execname()
}

probe syscall_entry
{
	counts[process_name] <<< 1
}

probe timer.s(5)
{
	@report_header
	foreach (name in counts)
		println(format_count(name, @count(counts[name])))
	exit()
}

probe syscall_exit += syscall.*.return
{
	finished = 1
}
