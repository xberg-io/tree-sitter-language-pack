VERSION 0.8
IMPORT github.com/earthly/lib/utils:3.0.2 AS utils
FROM golang:1.23
ARG --global APP=server
WORKDIR /src

deps:
    COPY go.mod go.sum ./
    RUN go mod download

build:
    FROM +deps
    COPY . .
    DO +GO_BUILD --out=/out/$APP
    SAVE ARTIFACT /out/$APP

GO_BUILD:
    FUNCTION
    ARG out
    RUN go build -o $out ./cmd/server

docker:
    COPY +build/server /server
    SAVE IMAGE example/server:latest
