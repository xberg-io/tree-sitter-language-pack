prototype(Vendor.Site:Component.Card) < prototype(Neos.Fusion:Component) {
    title = ''
    renderer = afx`<div>{props.title}</div>`
}

root = Neos.Fusion:Case {
    default {
        condition = true
        renderer = Vendor.Site:Component.Card
    }
}

prototype(Vendor.Site:Page) < prototype(Neos.Neos:Page) {
    body = Vendor.Site:Component.Card {
        title = 'Home'
    }
}
