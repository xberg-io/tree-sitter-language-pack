`define WIDTH 8

module counter #(parameter MAX = 255) (
  input wire clk,
  input wire reset,
  output reg [`WIDTH-1:0] count
);
  localparam STEP = 1;

  function [`WIDTH-1:0] next;
    input [`WIDTH-1:0] value;
    next = (value == MAX) ? 0 : value + STEP;
  endfunction

  task clear;
    count = 0;
  endtask

  always @(posedge clk) begin
    if (reset) count <= 0;
    else count <= next(count);
  end
endmodule

module top;
  reg clk;
  wire [7:0] value;
  counter #(.MAX(10)) u_counter (.clk(clk), .reset(1'b0), .count(value));
endmodule
