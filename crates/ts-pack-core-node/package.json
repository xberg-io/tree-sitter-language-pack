{
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "name": "@xberg-io/tree-sitter-language-pack",
  "version": "2.0.0",
  "description": "Pre-compiled tree-sitter grammars for 372 programming languages",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/tree-sitter-language-pack.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "binding.cjs",
    "index.mjs",
    "index.d.ts",
    "*.node"
  ],
  "optionalDependencies": {
    "@xberg-io/tree-sitter-language-pack-darwin-arm64": "2.0.0",
    "@xberg-io/tree-sitter-language-pack-darwin-x64": "2.0.0",
    "@xberg-io/tree-sitter-language-pack-linux-arm64-gnu": "2.0.0",
    "@xberg-io/tree-sitter-language-pack-linux-arm64-musl": "2.0.0",
    "@xberg-io/tree-sitter-language-pack-linux-x64-gnu": "2.0.0",
    "@xberg-io/tree-sitter-language-pack-linux-x64-musl": "2.0.0",
    "@xberg-io/tree-sitter-language-pack-win32-arm64-msvc": "2.0.0",
    "@xberg-io/tree-sitter-language-pack-win32-x64-msvc": "2.0.0"
  },
  "napi": {
    "packageName": "@xberg-io/tree-sitter-language-pack",
    "binaryName": "ts-pack-core-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "npx --yes -p @napi-rs/cli@^3.7.3 napi build --no-js --platform --release",
    "artifacts": "npx --yes -p @napi-rs/cli@^3.7.3 napi artifacts",
    "prepublishOnly": "npx --yes -p @napi-rs/cli@^3.7.3 napi prepublish -t npm --skip-optional-publish"
  },
  "engines": {
    "node": ">= 22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9"
  }
}
