{
  "name": "@xberg-io/ts-pack-cli",
  "version": "1.27.3",
  "mcpName": "io.github.xberg-io/tree-sitter-language-pack",
  "description": "CLI proxy for ts-pack — runs the native ts-pack binary shipped in a per-platform package, downloading it from GitHub releases only as a fallback.",
  "license": "MIT",
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/tree-sitter-language-pack.git",
    "directory": "cli-proxy/npm"
  },
  "bin": {
    "ts-pack": "bin/ts-pack.js"
  },
  "files": [
    "bin/",
    "install.js"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
