export VERSION='1.23.0'
export TAP='xberg-io/homebrew-tap'
export CLI_FORMULA='ts-pack'
FFI_FORMULA='libts-pack'
FFI_FORMULA_QUALIFIED="$TAP/$FFI_FORMULA"

setup_file() {
  brew trust "$TAP" || true
  brew bundle install --file="$BATS_TEST_DIRNAME/Brewfile"
}

setup() {
  export SCRIPT_DIR="$BATS_TEST_DIRNAME"
  bats_load_library xberg-bats
}

@test 'cli-version' {
  run bash -euo pipefail -c '$CLI_FORMULA --version | grep -Fxq "$CLI_FORMULA $VERSION" && printf "%s" "version-match"'
  xberg_assert_status 0
  xberg_assert_output_contains 'version-match'
}

@test 'cli-help' {
  run bash -euo pipefail -c '$CLI_FORMULA --help'
  xberg_assert_status 0
  xberg_assert_output_contains 'ts-pack'
}

@test 'ffi-language-list' {
  run bash -euo pipefail -c 'prefix=$(brew --prefix "$TAP/libts-pack")
scratch=$(mktemp -d)
trap '\''rm -rf "$scratch"'\'' EXIT
cc -I"$prefix/include" -L"$prefix/lib" -o "$scratch/languages_smoke" "$SCRIPT_DIR/languages_smoke.c" -lts_pack_core_ffi
"$scratch/languages_smoke"
'
  xberg_assert_status 0
  xberg_assert_output_contains 'PASS: ts_pack_available_languages returned:'
}

@test "ffi-smoke" {
  FFI_CFLAGS=""
  FFI_LIBS=""
  if command -v pkg-config &>/dev/null; then
    FFI_CFLAGS=$(pkg-config --cflags "$FFI_FORMULA" 2>/dev/null || true)
    FFI_LIBS=$(pkg-config --libs "$FFI_FORMULA" 2>/dev/null || true)
  fi
  if [[ -z "$FFI_CFLAGS" || -z "$FFI_LIBS" ]]; then
    FFI_PREFIX=$(brew --prefix "$FFI_FORMULA_QUALIFIED")
    FFI_CFLAGS="-I$FFI_PREFIX/include"
    FFI_LIB_NAME='ts_pack_core_ffi'
    FFI_LIBS="-L$FFI_PREFIX/lib -l${FFI_LIB_NAME}"
  fi
  # shellcheck disable=SC2086
  cc $FFI_CFLAGS -o "$BATS_TEST_TMPDIR/ffi_smoke" "$BATS_TEST_DIRNAME/ffi_smoke.c" $FFI_LIBS
  run "$BATS_TEST_TMPDIR/ffi_smoke"
  xberg_assert_status 0
}
